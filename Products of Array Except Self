class Solution:
    def productExceptSelf(self, nums):
        self.c=nums.count(0)
        self.l=[]
        if self.c==0:
            self.n=1
            for i in nums:
                self.n=self.n*i
            for k in nums:
                self.l.append(int(self.n/k))
        elif self.c==1:
            self.p=1
            self.inde=nums.index(0)
            for i in nums:
                self.l.append(0)
                if i!=0:
                    self.p=self.p*i
            self.l[self.inde]=self.p
        else:
            for i in nums:
                self.l.append(0)
        print(self.l)
        
v=eval(input())
h1=Solution()
h1.productExceptSelf(v)
