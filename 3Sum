class Solution:
    def threeSum(self,nums):
        n=len(nums)
        a=[]
        for i in range(0,n-2):
            for j in range(1,n-1):
                for k in range(2,n):
                    if i!=j and i!=k and j!=k:
                        if nums[i]+nums[j]+nums[k]==0:
                            l=[nums[i],nums[j],nums[k]]
                            l.sort()
                            a.append(l)
        tu=map(tuple,a)     #for converting a list pairs into tuple pairs
        se=set(tu)          #converting list to set for removing dublicate values
        result=list(se)     #converting back to list
        print(result)

list1=eval(input())
h1=Solution()
h1.threeSum(list1)
