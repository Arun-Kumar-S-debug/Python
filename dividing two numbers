class Solution(object):
    def divide(self,divident,divisor):
        if divisor>divident:
            return(0)
        else:
            v=1
            for i in range(1,30):
                divident=divident-divisor
                if divident>divisor:
                    v=v+1
                else:
                    break
            return(int(v))
        
