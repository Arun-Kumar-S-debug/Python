class Solution:
    def twoSum(self,nums,target):
        l=[]
        f=0
        for i in range(0,len(nums)):
            for j in range(1,len(nums)):
                if i!=j:
                    if nums[i]+nums[j]==target:
                        if f==0:
                            l.append(i)
                            l.append(j)
                            f=1
        print(l)

