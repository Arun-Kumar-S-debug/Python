class myclass():
    def plus(self):
        b=input()
        v=""
        n=0
        for i in b:
            if i!=",":
                if i!="[":
                    if i!="]":
                        v=v+i
                        n=n+1
        j=str(int(v)+1)
        listg=[]
        for k in j:
            listg.append(int(k))

        return(listg)

hp=myclass()
print(hp.plus())
