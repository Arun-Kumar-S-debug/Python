class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        count=0
        for i in range(0,len(nums)):
            for j in range(i+1,len(nums)+1):
                value=0
                for m in range(i,j):
                    value+=nums[m]
                if value==k:
                    count+=1
        return count
