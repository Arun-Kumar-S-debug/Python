class Solution:
    def isAnagram(self,s,t):
        l=[]
        k=[]
        for i in s:
            l.append(i)
        for i in t:
            k.append(i)
        l.sort()
        k.sort()
        if l==k:
            print("true")
        else:
            print("false")
    
s=input("s=")
